Screen {
    layout: vertical;
}

#main-container {
    width: 90%;
    height: 1fr;
    margin: 1 2;
    padding: 1 2;
    border: solid green;
}

#screen-title {
    width: 100%;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

#summary-action-row {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#expenses-summary {
    width: 24;
    height: 6;
    padding: 0 1;
    border: solid green;
}

#summary-title {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
}

#summary-count, #summary-total {
    width: 100%;
    height: 1;
}

#action-row {
    width: 1fr;
    height: 3;
    align: right middle;
}

#action-row Button {
    width: auto;
    min-width: 10;
    margin-left: 1;
}

.hidden {
    display: none;
}

#expenses-table {
    width: 100%;
    height: 1fr;
}

AddExpenseScreen, FilterExpenseScreen {
    align: center middle;
}

#add-expense-modal, #filter-expense-modal {
    width: 70;
    height: auto;
    padding: 1 2;
    border: thick green;
    background: $surface;
}

#modal-title {
    width: 100%;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

#modal-buttons {
    height: 3;
    align: center middle;
    margin-top: 1;
}

#modal-buttons Button {
    margin: 0 1;
}
