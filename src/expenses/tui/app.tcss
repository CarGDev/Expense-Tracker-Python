Screen {
    layout: vertical;
}

#main-container {
    width: 90%;
    height: 1fr;
    margin: 1 2;
    padding: 1 2;
    border: solid green;
}

#screen-title {
    width: 100%;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

#action-row {
    width: 100%;
    height: 3;
    align: center middle;
    margin-bottom: 1;
}

#action-row Button {
    margin: 0 1;
}

#expenses-table {
    width: 100%;
    height: 1fr;
}

AddExpenseScreen {
    align: center middle;
}

#add-expense-modal {
    width: 70;
    height: auto;
    padding: 1 2;
    border: thick green;
    background: $surface;
}

#modal-title {
    width: 100%;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

#modal-buttons {
    height: 3;
    align: center middle;
    margin-top: 1;
}

#modal-buttons Button {
    margin: 0 1;
}
